# -------------------------------------------------------------
# CAREERPILOT AI — ENVIRONMENT CONFIGURATION TEMPLATE
# -------------------------------------------------------------

# Application
ENVIRONMENT=development
PROJECT_NAME="CareerPilot AI"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-super-secret-key-at-least-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Database (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=careerpilot_user
POSTGRES_PASSWORD=careerpilot_secret
POSTGRES_DB=careerpilot_db
DATABASE_URL=postgresql+asyncpg://careerpilot_user:careerpilot_secret@localhost:5432/careerpilot_db
# For synchronous Alembic migrations:
SYNC_DATABASE_URL=postgresql://careerpilot_user:careerpilot_secret@localhost:5432/careerpilot_db

# Oracle AI Database (Optional enterprise provider)
ORACLE_ENABLED=false
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
ORACLE_WALLET_DIR=

# AI Provider Configuration
# Supported: gemini, openai, mock
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-pro
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSION=768

# Security & Limits
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_UPLOAD_EXTENSIONS=["pdf","docx","txt"]
RATE_LIMIT_PER_MINUTE=60
